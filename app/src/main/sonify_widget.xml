<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <!-- Dynamic rounded Spotify-style colored card background (rendered via Canvas) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP PLAYER SECTION -->
        <LinearLayout
            android:id="@+id/widget_player_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- LEFT SIDE: Logo + Controls (Compact 4x1 OR Expanded 4x2 layout) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Top Row: Sonify Waves Logo (left) + Title/Artist (right-aligned next to cover) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/widget_logo_btn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Sonify" />

                    <!-- Compact inline controls (shown only in 4x1 compact mode) -->
                    <LinearLayout
                        android:id="@+id/widget_compact_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="10dp">

                        <ImageView
                            android:id="@+id/widget_play_compact"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="Play" />

                        <ImageView
                            android:id="@+id/widget_next_compact"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="Next" />
                    </LinearLayout>

                    <!-- Title & Artist aligned cleanly next to album art -->
                    <LinearLayout
                        android:id="@+id/widget_text_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="Sonify"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="לחץ להפעלה"
                            android:textColor="#D9FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Expanded 4x2 Controls Row: Prev + Big White Circle Play/Pause + Next -->
                <LinearLayout
                    android:id="@+id/widget_expanded_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_prev_expanded"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Previous" />

                    <ImageView
                        android:id="@+id/widget_play_expanded"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="22dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Play/Pause" />

                    <ImageView
                        android:id="@+id/widget_next_expanded"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Next" />
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT SIDE: Rounded Album Artwork -->
            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:contentDescription="Album Art" />
        </LinearLayout>

        <!-- BOTTOM QUICK-SHORTCUTS SHELF (Auto-visible when widget is resized to 4x2, just like Spotify!) -->
        <LinearLayout
            android:id="@+id/widget_shelf"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_tile_0"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Shortcut 1" />

            <ImageView
                android:id="@+id/widget_tile_1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Shortcut 2" />

            <ImageView
                android:id="@+id/widget_tile_2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Shortcut 3" />

            <ImageView
                android:id="@+id/widget_tile_3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Shortcut 4" />

            <ImageView
                android:id="@+id/widget_tile_4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="Liked Songs" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
